{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "exclude": ["node_modules", "sandbox/**/*", "test/**/*"],
    "include": ["src/**/*", "src/**/*.vue"],
    "compilerOptions": {
        "composite": true,
        "noEmit": false,
        "emitDeclarationOnly": true,
        "esModuleInterop": true,
        "declaration": true,
        "declarationMap": false,
        "tsBuildInfoFile": "./node_modules/.cache/vue3-dnd-tree/build-types.tsbuildinfo",
        "skipLibCheck": true,
        "baseUrl": ".",
        "rootDir": "./src",
        "paths": {
            "@/*": ["./src/*"]
        }
    }
}