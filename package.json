{
  "name": "vue3-tree",
  "version": "0.1.0",
  "description": "A tree component for Vue 3 and Vuetify 3 with drag and drop support",
  "main": "dist/vue3-tree.umd.js",
  "module": "dist/vue3-tree.es.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/vue3-tree.es.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/vue3-tree.umd.js"
      }
    },
    "./style.css": "./dist/vue3-tree.css"
  },
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass"
  ],
  "scripts": {
    "dev": "vite",
    "build:clean": "shx rm -rf dist types",
    "build": "yarn typecheck && yarn build:clean && vite build && yarn build:types",
    "build:types": "vue-tsc --project tsconfig.build-types.json --declaration --emitDeclarationOnly --outDir dist/types",
    "typecheck": "vue-tsc --project tsconfig.build-types.json --noEmit",
    "test": "vitest",
    "prepublishOnly": "yarn build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uskithub/vue3-tree"
  },
  "homepage": "https://github.com/uskithub/vue3-tree#readme",
  "bugs": {
    "url": "https://github.com/uskithub/vue3-tree/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "vuetify",
    "vuetify3",
    "tree",
    "treeview",
    "component",
    "drag-and-drop",
    "plugin"
  ],
  "author": "Yusuke SAITO <yusuke.saito@jibunstyle.com>",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@mdi/font": "^7.0.0",
    "vue": "^3.3.0",
    "vuetify": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@mdi/font": {
      "optional": true
    },
    "vuetify": {
      "optional": true
    }
  },
  "dependencies": {
    "rfdc": "^1.4.1"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@mdi/font": "^7.4.47",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@volar/vue-language-plugin-pug": "^1.6.5",
    "@vue/language-plugin-pug": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "happy-dom": "^20.5.0",
    "pug": "^3.0.3",
    "sass": "^1.97.3",
    "shx": "^0.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.27",
    "vue-tsc": "^3.2.4",
    "vuetify": "^3.11.8"
  },
  "packageManager": "yarn@4.12.0"
}
