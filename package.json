{
  "name": "vue3-tree",
  "version": "0.1.0",
  "description": "A tree component for Vue 3 and Vuetify 3 with drag and drop support",
  "main": "dist/vue3-tree.umd.js",
  "module": "dist/vue3-tree.es.js",
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/src/index.d.ts",
        "default": "./dist/vue3-tree.es.js"
      },
      "require": {
        "types": "./dist/types/src/index.d.ts",
        "default": "./dist/vue3-tree.umd.js"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass"
  ],
  "scripts": {
    "dev": "vite",
    "build:clean": "shx rm -rf dist types",
    "build": "yarn typecheck && yarn build:clean && vite build && yarn build:types",
    "build:types": "vue-tsc --project tsconfig.build-types.json --declaration --emitDeclarationOnly --outDir dist/types",
    "typecheck": "vue-tsc --project tsconfig.build-types.json --noEmit",
    "test": "vitest",
    "prepublishOnly": "yarn build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uskithub/vue3-tree"
  },
  "homepage": "https://github.com/uskithub/vue3-tree#readme",
  "bugs": {
    "url": "https://github.com/uskithub/vue3-tree/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "vuetify",
    "vuetify3",
    "tree",
    "treeview",
    "component",
    "drag-and-drop",
    "plugin"
  ],
  "author": "Yusuke SAITO <yusuke.saito@jibunstyle.com>",
  "license": "Apache-2.0",
  "peerDependencies": {
    "vue": "^3.3.0",
    "vuetify": "^3.0.0",
    "@mdi/font": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "vuetify": {
      "optional": true
    },
    "@mdi/font": {
      "optional": true
    }
  },
  "dependencies": {
    "rfdc": "^1.3.0"
  },
  "devDependencies": {
    "@babel/types": "^7.20.7",
    "@types/node": "^18.11.18",
    "@vitejs/plugin-vue": "^4.0.0",
    "@volar/vue-language-plugin-pug": "^1.0.24",
    "@vue/language-plugin-pug": "^2.0.5",
    "@vue/test-utils": "^2.4.4",
    "@vue/tsconfig": "^0.1.3",
    "happy-dom": "^13.6.2",
    "pug": "^3.0.2",
    "sass": "^1.57.1",
    "shx": "^0.3.4",
    "typescript": "^4.9.4",
    "vite": "^4.4.9",
    "vitest": "^1.3.1",
    "vue": "^3.3.4",
    "vue-tsc": "^1.8.8",
    "vuetify": "^3.4.0"
  },
  "packageManager": "yarn@1.22.21"
}
